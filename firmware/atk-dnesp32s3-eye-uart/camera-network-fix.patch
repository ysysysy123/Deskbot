 void EspTcp::Disconnect() {
-    // 如果已经断开，直接返回
-    if (!connected_) {
-        return;
+    if (connected_) {
+        // 主动断开，需要等待接收任务退出
+        DoDisconnect(true);
+    } else if (receive_task_handle_ != nullptr && event_group_ != nullptr) {
+        // The peer may have closed the socket and cleared connected_ while the
+        // receive task is still finishing its disconnect callback.
+        auto bits = xEventGroupWaitBits(event_group_, ESP_TCP_EVENT_RECEIVE_TASK_EXIT,
+                                        pdFALSE, pdFALSE, pdMS_TO_TICKS(10000));
+        if (!(bits & ESP_TCP_EVENT_RECEIVE_TASK_EXIT)) {
+            ESP_LOGE(TAG, "Failed to wait for receive task exit");
+        } else {
+            receive_task_handle_ = nullptr;
+        }
     }
