# Copy to .env beside config.yaml. Exported environment variables take priority.
# Values are literal: use actual paths, not $VARIABLE or ${VARIABLE} expansion.

VOICE_LLM_BASE_URL=http://127.0.0.1:11434/v1
VOICE_LLM_MODEL=qwen2.5
VOICE_LLM_API_KEY=

# 智谱 GLM（使用时替换上方三项，密钥填在本机 .env）。
# VOICE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VOICE_LLM_MODEL=glm-4-flash

# 本地测试摄像头工具：同时启动 local_test.py，然后在页面连接语音服务。
# VOICE_MCP_ENABLED=true
# VOICE_MCP_URL=http://127.0.0.1:8006/mcp
# VOICE_MCP_TIMEOUT_SECONDS=20
# VOICE_MCP_MAX_ROUNDS=3
# 视觉请求独立于文字对话。BASE_URL/API_KEY 留空时继承 LLM 配置。
# VOICE_VISION_ENABLED=true
# VOICE_VISION_MODEL=glm-4v-flash
# VOICE_VISION_BASE_URL=
# VOICE_VISION_API_KEY=
# VOICE_VISION_TIMEOUT_SECONDS=60
# 持续对话使用 Silero VAD；回复中连续语音 180ms 触发打断。
# VOICE_VAD_MIN_SILENCE_DURATION_MS=600

# Any YAML option can be set as VOICE_<SECTION>_<FIELD>.
# VOICE_ASR_MODEL_PATH=models/SenseVoiceSmall
# VOICE_VAD_MODEL_PATH=models/snakers4_silero-vad
# VOICE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# VOICE_SERVER_WS_PORT=8000
# VOICE_SERVER_HOST=0.0.0.0
# VOICE_SERVER_OTA_HOST=0.0.0.0
# VOICE_SERVER_OTA_PORT=8003
# VOICE_SERVER_PUBLIC_WEBSOCKET_URL=ws://192.168.10.111:8000/xiaozhi/v1/
# VOICE_LOCAL_TEST_HOST=127.0.0.1
# VOICE_LOCAL_TEST_PORT=8006
# VOICE_MUSIC_ENABLED=false
# VOICE_DIALOGUE_SYSTEM_PROMPT='你是小桌，用简洁自然的中文回答。'

# Optional authentication (enable bearer mode when supplying a device token).
# VOICE_AUTH_MODE=bearer
# VOICE_AUTH_TOKEN=
# VOICE_MEMORY_ADMIN_TOKEN=

# Windows only: directory containing opus.dll; single quotes preserve backslashes.
# VOICE_OPUS_DLL_DIR='D:\Miniconda3\envs\xiaozhi-voice\Library\bin'
# FFMPEG='D:\tools\ffmpeg\bin\ffmpeg.exe'

# Standalone LAN music gateway also reads this file.
# NETEASE_API_URL=https://music.163.com
# NETEASE_COOKIE=
# MUSIC_HOST=0.0.0.0
# MUSIC_PORT=8010
