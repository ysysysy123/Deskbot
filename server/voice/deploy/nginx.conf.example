# Before exposing this site, set auth.ota_include_token to false.
# Place the following map/limit zones inside nginx's http {} block.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
limit_req_zone $binary_remote_addr zone=voice_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=voice_connections:10m;

server {
    listen 443 ssl http2;
    server_name voice.example.com;

    # Replace both paths with certificates supplied by the operator.
    ssl_certificate     /etc/nginx/tls/operator-supplied-fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/operator-supplied-private-key.pem;
    client_max_body_size 128k;

    location ^~ /xiaozhi/v1/ {
        limit_req zone=voice_requests burst=20 nodelay;
        limit_conn voice_connections 4;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # No URI suffix: nginx preserves /xiaozhi/v1/... exactly.
        proxy_pass http://127.0.0.1:8000;
    }

    location ^~ /xiaozhi/ota/ {
        limit_req zone=voice_requests burst=10 nodelay;
        limit_conn voice_connections 2;
        proxy_set_header Host $host;
        proxy_read_timeout 15s;
        # No URI suffix: nginx preserves /xiaozhi/ota/... exactly.
        proxy_pass http://127.0.0.1:8003;
    }

    # Deliberately no /api/ or port 8004 route.
}
