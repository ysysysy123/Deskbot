{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskbot.local/schema/envelope.schema.json",
  "title": "Deskbot protocol envelope",
  "type": "object",
  "required": ["version", "type", "id", "timestamp_ms", "payload"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
